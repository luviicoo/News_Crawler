# Browser: always hidden; a separate window opens only for manual CAPTCHA
HEADLESS=true

# Optional date range (Vietnam time); set both as YYYY-MM-DD
DATE_FROM=
DATE_TO=
# Optional single brand, e.g. Prudential (empty = all 9 brands)
BRAND=
# Default CSV-only; use --screenshots or SCREENSHOTS=true to capture images
SCREENSHOTS=false
# Extra publisher-specific discovery (empty = 16 default publishers)
PUBLISHER_DOMAINS=
# Web is complementary even when RSS returns articles; page caps are reported
WEB_MAX_PAGES=5
RSS_TIMEOUT_MS=30000

# Concurrency
ARTICLE_CONCURRENCY=3

# Timeouts (milliseconds)
PAGE_TIMEOUT=30000

# Delays (milliseconds)
SEARCH_DELAY_MIN=3000
SEARCH_DELAY_MAX=6000
RSS_DELAY_MIN=1000
RSS_DELAY_MAX=2000
ARTICLE_DELAY_MIN=500
ARTICLE_DELAY_MAX=1500
CAPTCHA_PAUSE_MS=120000
# Unsolved CAPTCHAs before the Google Search browser fallback is disabled for the run
CAPTCHA_MAX_PER_RUN=2

# Output directory, relative to this project root
OUTPUT_DIR=output

# Article classification: rules, hybrid, or gemini
CLASSIFIER_MODE=hybrid
CLASSIFIER_REVIEW_FALLBACK=reject

# Gemini (used in hybrid/gemini mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_MS=15000

# PR image capture
PR_IMAGE_CAPTURE_CONCURRENCY=3
