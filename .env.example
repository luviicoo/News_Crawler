# Browser: always hidden; a separate window opens only for manual CAPTCHA
HEADLESS=true

# Optional date range (Vietnam time); set both as YYYY-MM-DD
DATE_FROM=
DATE_TO=
# Brand/industry profile: a name in profiles/ or a path (empty = insurance-vn)
PROFILE=
# Optional single brand of the profile, e.g. Prudential (empty = all brands)
BRAND=
# Publisher-specific discovery (empty = the profile's publishers)
PUBLISHER_DOMAINS=
# Web is complementary even when RSS returns articles; page caps are reported
WEB_MAX_PAGES=5
RSS_TIMEOUT_MS=30000

# Shared SQLite store (empty = output/news.db)
STORE_PATH=

# Concurrency
# Articles read over HTTP at once, and at most this many per publisher
HTTP_CONCURRENCY=8
HTTP_PER_DOMAIN=2
# Browser tabs for articles HTTP cannot read (JavaScript pages, anti-bot checks)
ARTICLE_CONCURRENCY=3
# Google News links decoded over HTTP at once
GN_DECODE_CONCURRENCY=2
# Minimum gap between decodes; it doubles after an HTTP 429 and shortens again after long success streaks
GN_DECODE_DELAY_MS=2000
# Pause after an HTTP 429; doubles while Google keeps throttling (max 60 min)
GN_DECODE_COOLDOWN_MS=600000
# Articles classified at once in the enrich step (Gemini calls in hybrid/gemini mode)
ENRICH_CONCURRENCY=4

# Timeouts (milliseconds)
PAGE_TIMEOUT=30000

# Delays (milliseconds)
SEARCH_DELAY_MIN=3000
SEARCH_DELAY_MAX=6000
RSS_DELAY_MIN=1000
RSS_DELAY_MAX=2000
ARTICLE_DELAY_MIN=500
ARTICLE_DELAY_MAX=1500
CAPTCHA_PAUSE_MS=120000
# Unsolved CAPTCHAs before the Google Search browser fallback is disabled for the run
CAPTCHA_MAX_PER_RUN=2

# Output directory, relative to this project root
OUTPUT_DIR=output

# Article classification: rules, hybrid, or gemini
CLASSIFIER_MODE=hybrid
CLASSIFIER_REVIEW_FALLBACK=reject

# Gemini (used in hybrid/gemini mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000
# Characters from the start of the article sent to Gemini (0 = full text)
GEMINI_MAX_CONTENT_CHARS=6000
# Thinking tokens for flash models (0 = off: faster and cheaper; empty = model default)
GEMINI_THINKING_BUDGET=0
# Retries after a Gemini rate limit (429), overload (500/503) or timeout
GEMINI_MAX_RETRIES=4

