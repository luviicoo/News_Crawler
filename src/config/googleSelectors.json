{
  "_note": "Selector cho Google News dự phòng và Google Web tìm bổ sung. Khi nghi selector hỏng, crawler báo truy vấn chưa hoàn tất và lưu HTML để đối chiếu.",
  "searchBox": "textarea[name=\"q\"], input[name=\"q\"]",
  "resultsRoot": ["#search", "#rso", "#main"],
  "webHeadlines": "h3",
  "webNextPage": "#pnnext, a[aria-label=\"Next page\"], a[aria-label=\"Trang tiếp\"]",
  "cardContainerAttributes": ["data-hveid", "data-ved"],
  "headline": [
    "div[role=\"heading\"]",
    "h3",
    "h4",
    "[aria-level=\"3\"]",
    "[aria-level=\"2\"]"
  ],
  "publisher": [
    "cite",
    "[data-ved] span",
    "span[class*=\"source\"]",
    "span[class*=\"Source\"]",
    ".NUnG9d",
    ".vr1PYe",
    ".VkSnBd",
    ".TbwUpd",
    "[data-n-tid]",
    "span[jsname]"
  ],
  "consentButtons": [
    "#L2AGLb",
    "button:has-text(\"Accept all\")",
    "button:has-text(\"Chấp nhận tất cả\")",
    "button:has-text(\"Agree\")",
    "button:has-text(\"Đồng ý\")",
    "[aria-label=\"Accept all\"]",
    "form[action*=\"consent\"] button"
  ],
  "captchaPatterns": [
    "unusual traffic",
    "captcha",
    "i'm not a robot",
    "xác minh bạn không phải robot",
    "lưu lượng truy cập bất thường",
    "/sorry/index"
  ],
  "noResultsPatterns": [
    "did not match any",
    "no results found",
    "không tìm thấy kết quả",
    "không khớp với bất kỳ"
  ]
}
